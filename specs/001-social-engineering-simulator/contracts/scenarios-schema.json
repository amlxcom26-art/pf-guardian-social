{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardianSocialScenariosSchema",
  "description": "Contrato formal de dados para o arquivo de cenários educacionais do Guardian Social",
  "type": "object",
  "required": ["version", "scenarios"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "type",
          "title",
          "sender",
          "body",
          "inspectableElements",
          "isThreat",
          "threatCategory",
          "iocs",
          "emotionalTriggers",
          "educationalFeedback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^scenario-[0-9]{2,}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": ["email", "sms", "login"]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "sender": {
            "type": "object",
            "required": ["displayName", "address"],
            "properties": {
              "displayName": { "type": "string" },
              "address": { "type": "string" },
              "securityStatus": { "type": "string" }
            }
          },
          "body": {
            "type": "string",
            "minLength": 10
          },
          "inspectableElements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "displayText", "simulatedDestination", "isDeceptive", "explanation"],
              "properties": {
                "id": { "type": "string" },
                "displayText": { "type": "string" },
                "simulatedDestination": { "type": "string" },
                "isDeceptive": { "type": "boolean" },
                "explanation": { "type": "string" }
              }
            }
          },
          "isThreat": {
            "type": "boolean"
          },
          "threatCategory": {
            "type": "string"
          },
          "iocs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "emotionalTriggers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "educationalFeedback": {
            "type": "object",
            "required": ["correctExplanation", "incorrectExplanation", "keyRule", "categoryTakeaway"],
            "properties": {
              "correctExplanation": { "type": "string" },
              "incorrectExplanation": { "type": "string" },
              "keyRule": { "type": "string" },
              "categoryTakeaway": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
